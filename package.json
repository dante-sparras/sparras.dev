{
  "name": "sparras.dev",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "hooks:enable": "git config core.hooksPath githooks",
    "prepare": "bun run hooks:enable || true",
    "dev": "bun run hooks:enable && next dev",
    "build": "bun run hooks:enable && next build",
    "start": "next start",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests --pass-with-no-tests",
    "check": "bun run hooks:enable && oxfmt --check && oxlint . && tsc --noEmit",
    "precommit": "bun run hooks:enable && lint-staged && oxfmt --check && oxlint . && tsc --noEmit",
    "prepush": "bun run hooks:enable && next build"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "lucide-react": "^1.23.0",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.12.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.3.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "lint-staged": "^16.2.7",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,css,md,mdx}": "oxfmt --write"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
